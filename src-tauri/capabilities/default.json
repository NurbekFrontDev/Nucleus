{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Базовые разрешения для главного окна",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "updater:default",
    "process:default",
    "autostart:default",
    "deep-link:default",
    "shell:allow-open",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "F:\\SecondBrain\\personal\\Diary\\**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "F:\\SecondBrain\\personal\\Diary\\**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "F:\\SecondBrain\\personal\\Diary\\audio\\**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "F:\\SecondBrain\\personal\\Diary" },
        { "path": "F:\\SecondBrain\\personal\\Diary\\**" }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "F:\\SecondBrain\\personal\\Diary\\**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "F:\\SecondBrain\\personal\\Diary" },
        { "path": "F:\\SecondBrain\\personal\\Diary\\**" }
      ]
    }
  ]
}
