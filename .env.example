# Копия этого файла — реальный .env (он в .gitignore и не попадает в GitHub)
# Значения берутся в Supabase: Settings -> API
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-publishable-key
# Дневник: серверные ключи AI (та же пара, что в секретах GEMINI_API_KEY/GROQ_API_KEY diary-ai).
# Вшиваются в бандл настроек дневника; без них поля ключей пустые, работает серверный секрет.
VITE_DIARY_GEMINI_KEY=
VITE_DIARY_GROQ_KEY=
